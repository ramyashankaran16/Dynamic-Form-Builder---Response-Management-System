# ---------------------------------------------------------------
# Copy to .env  ->  cp .env.example .env
# Used by docker compose (variable substitution) and by the app
# when running locally without Docker.
# ---------------------------------------------------------------
ENVIRONMENT=development
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MySQL (docker compose) ---
MYSQL_DATABASE=form_builder
MYSQL_USER=formbuilder
MYSQL_PASSWORD=formbuilder
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST_PORT=3307

# --- Local run without Docker (ignored by docker compose, which builds its own URL) ---
DATABASE_URL=mysql+pymysql://formbuilder:formbuilder@localhost:3307/form_builder?charset=utf8mb4
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
BACKEND_PORT=8000

# --- First admin (created on first start) ---
FIRST_ADMIN_EMAIL=admin@formbuilder.com
FIRST_ADMIN_PASSWORD=Admin@123
FIRST_ADMIN_NAME=System Administrator
